 }
 
 body {
-  background: var(--background);
-  color: var(--foreground);
-  font-family: Arial, Helvetica, sans-serif;
+  background: var(--color-background);
+  color: var(--color-text);
+  font-family: var(--font-body-ja), var(--font-body-en), "Noto Sans JP",
+    "Hiragino Kaku Gothic ProN", sans-serif;
+}
+
+h1,
+h2,
+h3 {
+  font-family: var(--font-heading-ja), var(--font-heading-en),
+    "Shippori Mincho", "Hiragino Mincho ProN", serif;
+}
+
+/* Visible focus ring everywhere, including over the dark hero image
+   (Phase 2A §19) — never removed without a replacement. */
+:focus-visible {
+  outline: 2px solid var(--color-accent);
+  outline-offset: 3px;
+  border-radius: var(--radius-sm);
+}
+
+::selection {
+  background: var(--color-accent);
+  color: var(--color-on-accent);
+}
+
+/* Hero entrance animation (Phase 2A §21) — single fade/rise on load,
+   pure CSS so it costs nothing on the main thread. */
+@keyframes hero-enter {
+  from {
+    opacity: 0;
+    transform: translateY(8px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+.animate-hero-enter {
+  animation: hero-enter 400ms ease-out both;
+}
+
+/* Scroll-reveal primitive used by components/ui/Reveal.tsx. */
+.reveal-hidden {
+  opacity: 0;
+  transform: translateY(8px);
+}
+
+.reveal-visible {
+  opacity: 1;
+  transform: translateY(0);
+  transition:
+    opacity 300ms ease-out,
+    transform 300ms ease-out;
+}
+
+/* Stagger delays (Reveal's delayMs) are removed on mobile so quick
+   scrolling never feels like it's making content wait to appear
+   (Phase 2A §21/§22). */
+@media (max-width: 639px) {
+  [data-reveal] {
+    transition-delay: 0ms !important;
+  }
