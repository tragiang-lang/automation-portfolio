# --- Public (bundled into the browser) ---
#
# The LIFF app ID from the LINE Developers console. Required for
# `lib/liff.ts`'s `initializeSiteReportLiff()` to call `liff.init()` at
# all -- without it, initialization resolves to a
# `LIFF_CONFIG_MISSING` error state rather than crashing. A LIFF ID is
# not a secret, but it must still be prefixed with `NEXT_PUBLIC_` because
# the LIFF SDK runs client-side, in the LINE in-app browser.
NEXT_PUBLIC_LIFF_ID=

# --- Server-only (never sent to the browser) ---
#
# The deployed Site Report GAS Web App's full URL, ending in `/exec`
# (Apps Script editor -> Deploy -> New deployment -> Web app -> copy the
# "Web app" URL after deploying with access "Anyone"). Read only by
# apps/site-report/web/lib/api/siteReportClient.ts's callSiteReportAction,
# which POSTs { action, payload } to this URL unchanged -- it does not
# append /exec or any other path itself, so the value here must already
# be the complete deployed URL. Never prefix this with NEXT_PUBLIC_ --
# unlike NEXT_PUBLIC_LIFF_ID above, this must stay server-side (Route
# Handlers / Server Components / Server Actions only; this app's one
# caller as of Task 11 is components/site-report/submission.ts, invoked
# from the SiteReportScreen Client Component but never itself running in
# the browser -- see docs/site-report-architecture-overview.md).
GAS_WEBAPP_URL=
