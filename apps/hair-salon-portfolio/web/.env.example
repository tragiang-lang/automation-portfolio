# GAS Web App deployment URL for the getConfig action.
# Leave unset for local/demo mode -- the site automatically falls back to
# config/demo-content.ts (see docs/config-and-sheets-guide.md).
#
# Never prefix this with NEXT_PUBLIC_ -- it must stay server-only. It is
# read only by apps/hair-salon-portfolio/web/lib/api/gasClient.ts.
GAS_WEBAPP_URL=

# Design preset for this deployment. atelier ito ships as "starter" -- a
# bare-bones Hero+Menu+Reservation-CTA+Contact composition. Never prefix
# this with NEXT_PUBLIC_ -- it is read only by
# apps/hair-salon-portfolio/web/lib/config/designConfig.ts, server-side.
SALON_DESIGN_PRESET=starter

# Explicit Reservation Wizard demo-mode switch. Set to exactly "true" to
# make the reservation wizard's catalog (getServices/getStaff) and
# availability (getAvailability) use deterministic demo data regardless of
# whether GAS_WEBAPP_URL is configured -- e.g. for a Coconala buyer demo
# deployment. Reservation/contact SUBMISSION always still calls real GAS
# and fails honestly if it is unavailable; this switch never affects
# submitReservation/createInquiry. Leave unset (or any other value) for
# normal behavior, where a GAS failure remains a real error instead of
# silently falling back to demo data (see lib/config/reservationDemoMode.ts
# for why this is intentionally NOT the same "any failure -> demo" rule
# runtimeConfig.ts/runtimeCatalog.ts use for read-only homepage content).
# Never prefix this with NEXT_PUBLIC_ -- it is read only by
# apps/hair-salon-portfolio/web/lib/config/reservationDemoMode.ts, server-side.
SALON_RESERVATION_DEMO_MODE=
