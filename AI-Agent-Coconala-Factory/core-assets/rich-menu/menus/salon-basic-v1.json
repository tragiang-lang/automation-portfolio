{
  "kind": "rich-menu",
  "id": "salon-basic-v1",
  "version": "1.0.0",
  "description": "Six-button menu for appointment-based salons: booking first, then menu, inquiry, access, hours and a style gallery link.",
  "industries": [
    "hair_salon",
    "beauty_salon",
    "nail_salon"
