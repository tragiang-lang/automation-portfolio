{
  "kind": "action",
  "id": "getAvailability",
  "version": "1.0.0",
  "description": "Bookable start times for one date, from opening hours, closed dates, lead time, booking window and capacity. API-only in Phase 1 (for a Phase 2 booking screen).",
  "status": "available",
  "exposure": [
    "api"
  ],
  "reusable": true,
  "industrySpecific": false,
  "input": {
    "date": {
      "type": "date",
      "required": true
    },
    "serviceId": {
      "type": "string",
      "maxLength": 50
    }
  },
  "output": {
    "date": {
      "type": "date",
      "required": true
    },
    "durationMinutes": {
      "type": "integer",
      "required": true
    },
    "startTimes": {
      "type": "array",
      "required": true
    }
  },
  "dependencies": {
    "sheets": [
      "CONFIG",
      "RESERVATIONS",
      "SERVICES"
    ],
    "configKeys": [
      {
        "key": "hours.mon",
        "type": "string",
        "required": false,
        "default": "closed",
        "description": "営業時間 (mon) 例: 10:00-19:00 / 定休日は closed"
      },
      {
        "key": "hours.tue",
        "type": "string",
        "required": false,
        "default": "closed",
        "description": "営業時間 (tue) 例: 10:00-19:00 / 定休日は closed"
      },
      {
        "key": "hours.wed",
        "type": "string",
        "required": false,
        "default": "closed",
        "description": "営業時間 (wed) 例: 10:00-19:00 / 定休日は closed"
      },
      {
        "key": "hours.thu",
        "type": "string",
        "required": false,
        "default": "closed",
        "description": "営業時間 (thu) 例: 10:00-19:00 / 定休日は closed"
      },
      {
        "key": "hours.fri",
        "type": "string",
        "required": false,
        "default": "closed",
        "description": "営業時間 (fri) 例: 10:00-19:00 / 定休日は closed"
      },
      {
        "key": "hours.sat",
        "type": "string",
        "required": false,
        "default": "closed",
        "description": "営業時間 (sat) 例: 10:00-19:00 / 定休日は closed"
      },
      {
        "key": "hours.sun",
        "type": "string",
        "required": false,
        "default": "closed",
        "description": "営業時間 (sun) 例: 10:00-19:00 / 定休日は closed"
      },
      {
        "key": "reservation.slotMinutes",
        "type": "number",
        "required": false,
        "default": "30",
        "description": "予約枠の間隔（分）"
      },
      {
        "key": "reservation.defaultDurationMinutes",
        "type": "number",
        "required": false,
        "default": "60",
        "description": "メニュー未指定時の所要時間（分）"
      },
      {
        "key": "reservation.minLeadHours",
        "type": "number",
        "required": false,
        "default": "3",
        "description": "何時間前まで予約を受け付けるか"
      },
      {
        "key": "reservation.maxDaysAhead",
        "type": "number",
        "required": false,
        "default": "60",
        "description": "何日先まで予約を受け付けるか"
      },
      {
        "key": "reservation.capacity",
        "type": "number",
        "required": false,
        "default": "1",
        "description": "同じ時間帯に受け付ける予約数（席数・スタッフ数）"
      },
      {
        "key": "reservation.closedDates",
        "type": "string",
        "required": false,
        "default": "",
        "description": "臨時休業日（カンマ区切り 例: 2026-12-31,2027-01-01）"
      },
      {
        "key": "notification.ownerEmail",
        "type": "email",
        "required": false,
        "description": "新しいお問い合わせ・予約リクエストの通知先メールアドレス（店舗用）"
      }
    ],
    "services": [
      "tables"
    ],
    "scriptProperties": []
  },
  "validation": [
    "date must be a real YYYY-MM-DD date",
    "serviceId must exist in SERVICES when given"
  ],
  "errors": [
    {
      "code": "VALIDATION_ERROR",
      "when": "bad date or unknown serviceId"
    },
    {
      "code": "CONFIG_INVALID",
      "when": "a reservation.* number is not numeric"
    }
  ],
  "gas": {
    "module": "reservation-basic"
  }
}
