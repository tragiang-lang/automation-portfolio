{
  "kind": "action",
  "id": "getBusinessInfo",
  "version": "1.0.0",
  "description": "Returns the business profile (name, address, phone, map URL, opening hours text) from CONFIG. Read-only.",
  "status": "available",
  "exposure": [
    "api",
    "line"
  ],
  "reusable": true,
  "industrySpecific": false,
  "input": {
    "view": {
      "type": "string",
      "enum": [
        "all",
        "access",
        "hours"
      ],
      "description": "Which part to show in a LINE reply."
    }
  },
  "output": {
    "view": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "phone"
    },
    "mapUrl": {
      "type": "string"
    },
    "hoursText": {
      "type": "string"
    },
    "accessNote": {
      "type": "string"
    }
  },
  "dependencies": {
    "sheets": [
      "CONFIG"
    ],
    "configKeys": [
      {
        "key": "business.name",
        "type": "string",
        "required": true,
        "description": "店舗名"
      },
      {
        "key": "business.address",
        "type": "string",
        "required": false,
        "description": "住所"
      },
      {
        "key": "business.phone",
        "type": "string",
        "required": false,
        "description": "電話番号"
      },
      {
        "key": "business.mapUrl",
        "type": "url",
        "required": false,
        "description": "地図URL（Google マップ等）"
      },
      {
        "key": "business.hoursText",
        "type": "text",
        "required": false,
        "description": "営業時間の案内文 例: 10:00〜19:00（火曜定休）"
      },
      {
        "key": "business.accessNote",
        "type": "text",
        "required": false,
        "description": "アクセス案内 例: 〇〇駅 徒歩3分"
      }
    ],
    "services": [
      "tables"
    ],
    "scriptProperties": []
  },
  "validation": [
    "view must be one of all/access/hours"
  ],
  "errors": [
    {
      "code": "CONFIG_INVALID",
      "when": "business.name is not set"
    },
    {
      "code": "VALIDATION_ERROR",
      "when": "view is not a known value"
    }
  ],
  "gas": {
    "module": "business-info"
  }
}
