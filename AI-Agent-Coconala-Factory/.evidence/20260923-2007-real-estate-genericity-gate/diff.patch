+{
+  "kind": "industry",
+  "id": "real-estate-v1",
+  "version": "1.0.0",
+  "industry": "real_estate",
+  "category": "real_estate",
+  "displayName": "不動産 / Real Estate",
+  "businessType": "Small local real-estate agency (賃貸・売買仲介). First contact is a property or condition inquiry; the conversion goal is a viewing (内見) or in-store consultation request that staff confirm by hand.",
+  "customerIntents": [
+    "ask_question",
+    "book",
+    "find_access",
+    "check_hours"
+  ],
+  "lineUseCases": [
+    "物件・条件についてのお問い合わせ（空室確認・家賃・初期費用など）",
+    "内見予約リクエスト（スタッフが物件側と調整のうえ確定連絡）",
+    "来店相談予約リクエスト",
+    "会社・店舗情報、アクセス、営業時間の確認",
+    "物件一覧は既存の自社Webサイト／ポータルへリンク（Phase 1では物件データを持たない）"
+  ],
+  "recommendedWorkflows": [
+    "inquiry-basic-v1",
+    "reservation-basic-v1",
+    "business-info-v1"
+  ],
+  "recommendedRichMenu": "real-estate-basic-v1",
+  "recommendedDesignPresets": [
+    "clean-professional-v1",
+    "minimal-modern-v1"
+  ],
+  "terminology": {
+    "inquiry": "物件・条件のお問い合わせ",
+    "reservation": "内見・来店相談の予約リクエスト（確定ではありません）",
+    "viewing": "内見",
+    "property": "物件",
+    "capacity": "同じ時間帯に受けられる内見・相談の件数（対応できるスタッフ数）",
+    "owner": "担当スタッフ・店舗"
+  },
+  "requiredData": [
+    "CONFIG: 会社・店舗名・住所・電話番号・地図URL・営業時間（定休日を含む）",
+    "reservation.capacity: 同じ時間帯に対応できる内見・相談の件数",
+    "reservation.defaultDurationMinutes: 内見・相談1件あたりの目安時間",
+    "reservation.minLeadHours: 物件側との調整に必要な時間（例: 24時間前まで）",
+    "brief config links.propertySiteUrl: 既存の物件一覧ページ（Rich Menu の URI ボタン）",
+    "SERVICES: reservation-basic-v1 の構造上シートは作成されるが、不動産では空のままでよい（serviceId は任意）"
+  ],
+  "notificationRequirements": [
+    "Owner email on every inquiry",
+    "Owner email on every viewing / consultation reservation request"
+  ],
+  "risks": [
+    "A viewing request is only a REQUESTED row. Staff must confirm the slot with the property owner/management company and set status to CONFIRMED by hand; the customer is not told it is confirmed.",
+    "reservation-basic-v1 records only a date-time. The customer cannot pick which property to view from the Rich Menu, so staff must ask by LINE/phone after the request (planned: property-viewing-v2).",
+    "The LINE reply text from createReservation@1 says 「ご予約リクエストを受け付けました」, not 「内見予約リクエスト」. It is correct (request, not confirmation) but generic.",
+    "reservation.capacity counts parallel requests, not staff or vehicles; per-agent scheduling is not supported (planned: agent-assignment-v2).",
+    "Property availability changes daily; no property data is stored in Phase 1, so answers about vacancies are given by staff manually via INQUIRIES."
+  ],
+  "assumptions": [
+    "The agency already publishes its property list on its own website or a portal; the Rich Menu links to it instead of storing properties.",
+    "Viewing and in-store consultation share one reservation-basic-v1 flow; staff tell them apart from the follow-up conversation.",
+    "Opening hours follow the common real-estate pattern (水曜定休)."
+  ],
+  "extensionPoints": {
+    "implemented": [
+      "inquiry-basic-v1: 物件・条件のお問い合わせ",
+      "reservation-basic-v1: 内見・来店相談の予約リクエスト（REQUESTED のみ）",
+      "business-info-v1: 会社・店舗情報 / アクセス / 営業時間",
+      "Rich Menu URI button to an existing property list page (links.propertySiteUrl)"
+    ],
+    "planned": [
+      { "id": "property-catalog-v1", "description": "PROPERTIES sheet schema (property_catalog = deferred; no current workflow reads it)." },
+      { "id": "property-search-v2", "description": "Search/filter properties by area, rent and layout from LINE." },
+      { "id": "property-detail-v2", "description": "Flex Message card per property with photos and conditions." },
+      { "id": "property-viewing-v2", "description": "Viewing request tied to a specific propertyId." },
+      { "id": "agent-assignment-v2", "description": "Assign a staff member per viewing; per-agent availability." },
+      { "id": "property-status-sync-v1", "description": "Sync vacancy status from a portal or management system." },
+      { "id": "calendar-integration-v1", "description": "Google Calendar busy times / events on CONFIRMED (reuses reservation-basic-v1 google-calendar extension point)." },
+      { "id": "customer-history-v1", "description": "Past inquiries and viewings per customer for staff follow-up." }
+    ]
+  }
+}
